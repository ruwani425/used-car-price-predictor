# Backend Gateway Environment Variables
PORT=5000
ML_SERVICE_URL=http://localhost:8000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Open Exchange Rates API (https://openexchangerates.org)
# If left blank, defaults to public live exchange rates mirror or fallback registry
OPEN_EXCHANGE_APP_ID=

# Redis Cache Configuration (Default: redis://127.0.0.1:6379)
REDIS_URL=redis://127.0.0.1:6379

# Currency Cron Job Schedule (Default: '0 */3 * * *' = Every 3 hours)
CURRENCY_CRON_SCHEDULE=0 */3 * * *
